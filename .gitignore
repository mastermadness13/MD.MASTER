__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
.eggs/
venv/
env/
.venv/
.venv-1/
node_modules/

# static/dist/ is the compiled Tailwind/JS bundle and MUST be committed.
# The `dist/` rule above is a Python build-artifact rule; it used to catch
# static/dist/ too, which meant a fresh clone or deploy shipped no Tailwind
# at all and the whole UI rendered unstyled (no CDN fallback exists any more).
# Rebuild with `npm run build` and commit the result alongside the source.
!static/dist/
!static/dist/**
*.db-journal
*.sqlite
*.sqlite3
*.backup
*.db
instance/
.webassets-cache
.env
*.log
.DS_Store
Thumbs.db
.secret_key
_tmp_*
flask_err*
startup_*
wsgi_config*.py
*.pyc

# Backup files (prevent .bak tracking — was causing committed DB backups)
*.bak
*.bak-*
database/backups/

# Debug/dev artifacts
scripts/logs/
logs/
.pytest_cache/
server.err.log
server.out.log
import_dryrun.txt

# User uploads (large, user-specific, not source-controlled)
uploads/
*.rar

# Stray/legacy artifacts outside the codebase
/3
/مشروع تخرح للكلية/

# Local AI tooling state
.agents/
.continue/
.qodo/

# Project-local archives (not runtime, but user data)
_archive/
