# PythonAnywhere deployment environment variables
# Copy this to .env and fill in the values

# Flask secret key — generate a strong one: python -c "import secrets; print(secrets.token_hex(32))"
# If unset, a random key is generated and persisted to .secret_key (git-ignored).
SECRET_KEY=change-me-to-a-random-string

# Session cookie flags. Leave SESSION_COOKIE_SECURE on for HTTPS deployments;
# set it to false only for plain-HTTP local development.
SESSION_COOKIE_SECURE=true

# Database path (leave default if using the bundled SQLite DB)
# DATABASE=/home/yourusername/newRopey/data/data.db

# Upload folder (leave default if using the bundled uploads folder)
# UPLOAD_FOLDER=/home/yourusername/newRopey/uploads

# ── Reverse-proxy (nginx / cPanel / Passenger) ──────────────────────────
# Behind a TLS-terminating proxy the app sees http://, so external links
# (password-reset mails, redirects) would be downgraded. Trust X-Forwarded-*
# ONLY when a proxy fronts the app, and ONLY from its IPs. Without
# TRUSTED_PROXY_IPS the headers are ignored (fail-safe).
# TRUST_PROXY_HEADERS=true
# TRUSTED_PROXY_IPS=127.0.0.1,10.0.0.0/8

# ── Base URL for password-reset links ───────────────────────────────────
# Required in production. The reset link is a bearer credential, so its
# origin must NOT be derived from the request's Host header.
# RESET_BASE_URL=https://ropey.example.edu.ly

# ── Mail (SMTP) settings for password-reset emails ────────────────────────
# For Gmail: use an App Password (https://myaccount.google.com/apppasswords)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_DEFAULT_SENDER=noreply@zuwaratc.edu.ly
