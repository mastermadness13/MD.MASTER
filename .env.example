# PythonAnywhere deployment environment variables
# Copy this to .env and fill in the values

# Flask secret key — generate a strong one: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-string

# Database path (leave default if using the bundled SQLite DB)
# DATABASE=/home/yourusername/newRopey/data/data.db

# Upload folder (leave default if using the bundled uploads folder)
# UPLOAD_FOLDER=/home/yourusername/newRopey/uploads

# ── Mail (SMTP) settings for password-reset emails ────────────────────────
# For Gmail: use an App Password (https://myaccount.google.com/apppasswords)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_DEFAULT_SENDER=noreply@zuwaratc.edu.ly
